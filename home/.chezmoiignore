# shellcheck disable=all
.inputrc
.aliases.local
.exports.local
.functions.local
.gitconfig.local
.zprofile.local
.zsh_completions.local
.zshrc.local
.config/ghostty/config.local
.ssh/config.local
# Finder drops these anywhere it browses; oh-my-zsh is an external so every
# stray one read as a file to delete on the next apply.
**/.DS_Store
.oh-my-zsh/cache/**

{{ if ne .chezmoi.os "darwin" -}}
.hammerspoon
.config/raycast
.config/iterm2
Library/LaunchAgents/com.froppa.clip-serve.plist
.local/bin/clip-serve
# evo-dev runs the real Linux Depot binary the evo development role installs
# at ~/.local/bin/depot; the Cargo-install symlink must not replace it.
.local/bin/depot
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# The Mac serves the clipboard to remote hosts; only they need the shim.
.local/bin/wl-paste
{{ end -}}
