{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Reload the clipboard bridge whenever its LaunchAgent changes.
# plist-sha256: {{ include "private_Library/private_LaunchAgents/local.dotfiles.clip-serve.plist.tmpl" | sha256sum }}

label=local.dotfiles.clip-serve
mkdir -p "$HOME/.cache"
# Retire another label only when it launches this exact managed command.
for plist in "$HOME/Library/LaunchAgents/"*.plist; do
  [ -f "$plist" ] || continue
  program=$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null) || continue
  [ "$program" = "$HOME/.local/bin/clip-serve" ] || continue
  previous=$(plutil -extract Label raw -o - "$plist" 2>/dev/null) || continue
  [ "$previous" != "$label" ] || continue
  launchctl bootout "gui/$(id -u)/$previous" 2>/dev/null || true
  rm -f "$plist"
done
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
# bootout returns before teardown finishes; a lost race must not abort apply.
launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist" 2>/dev/null ||
  launchctl kickstart -k "gui/$(id -u)/$label"
{{ end -}}
