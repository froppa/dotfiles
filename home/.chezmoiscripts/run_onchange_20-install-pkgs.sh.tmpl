#!/usr/bin/env bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
command -v brew >/dev/null 2>&1 || {
  echo "=> brew not found, skipping package install"
  exit 0
}

echo "=> Installing packages..."

brew bundle --file=/dev/stdin <<'BREWFILE'
{{ range .packages.brews -}}
brew "{{ . }}"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.darwin.brews -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.casks -}}
cask "{{ . }}"
{{ end -}}
{{ end -}}
{{ if .personal -}}
{{ range .packages.personal.brews -}}
brew "{{ . }}"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.personal.casks -}}
cask "{{ . }}"
{{ end -}}
{{ end -}}
{{ end -}}
{{ if .work -}}
{{ range .packages.work.brews -}}
brew "{{ . }}"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .packages.work.casks -}}
cask "{{ . }}"
{{ end -}}
{{ end -}}
{{ end -}}
BREWFILE

brew cleanup
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
packages=(
{{ range .packages.ubuntu.apt }}  "{{ . }}"
{{ end -}}
)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]]; then
    missing+=("$package")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "${missing[@]}"
else
  echo "=> Ubuntu packages already installed"
fi
{{ else -}}
echo "Package bootstrap supports macOS and Ubuntu; install packages manually on this OS." >&2
exit 1
{{ end -}}
