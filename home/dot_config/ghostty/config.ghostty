# Appearance
theme = iTerm2 Tango Dark

font-family = MesloLGS NF
font-size = 14
font-feature = -calt, -liga, -dlig
font-thicken = false
bold-color = bright
faint-opacity = 1

background = #000000
foreground = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000

# Command-F search: a plain hit dimmed, the focused hit in the selection colour.
search-background = #303030
search-foreground = #ffffff
search-selected-background = #b5d5ff
search-selected-foreground = #000000

cursor-color = #ffffff
cursor-text = #000000
cursor-style = bar
cursor-style-blink = true

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
background-opacity = 0.8
background-opacity-cells = false
background-blur = true
# Unfocused splits already dim themselves.
split-divider-color = #303030

macos-titlebar-style = tabs
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# Input
mouse-hide-while-typing = false
focus-follows-mouse = false
copy-on-select = clipboard
right-click-action = context-menu

# iTerm had unlimited scrollback; Ghostty uses a byte limit.
scrollback-limit = 268435456
scrollbar = system

# Visual bell without sound
bell-features = no-system,no-audio,attention,no-border

# Send the standard clear-screen key to the active application.
keybind = super+k=text:\x0c

# A command that ran longer than five seconds and finishes while you are looking elsewhere marks
# the tab through bell-features and posts a notification.
# notify-on-command-finish = unfocused
# notify-on-command-finish-action = bell,notify

# Remove the legacy Ctrl-V mapping so Claude Code receives native Shift-Enter.
keybind = shift+enter=unbind

# Shell
shell-integration = zsh
shell-integration-features = cursor,title,ssh-env,path
command = direct:herdr

# herdr drives panes and tabs from the Raycast Hyper (Ctrl+Option+Command)
# chords in ~/.config/herdr/config.toml. Ghostty binds none of them, so they
# reach herdr with Command intact over the kitty keyboard protocol. Chords
# herdr has no action for are swallowed here: sent through, a shell reads
# them as Escape plus a control key (Hyper-M as Enter).
keybind = ctrl+alt+super+equal=ignore
keybind = ctrl+alt+super+w=ignore
keybind = ctrl+alt+super+Digit0=ignore
keybind = ctrl+alt+super+tab=ignore
keybind = ctrl+alt+super+b=ignore
keybind = ctrl+alt+super+j=ignore
keybind = ctrl+alt+super+m=ignore
keybind = ctrl+alt+super+u=ignore

# Machine-local overrides, last so they win. Optional: a machine without one
# is not an error. This is where a Dock-launched Ghostty, which has launchd's
# PATH and cannot find ~/.local/bin, names herdr's absolute path — the
# portable `direct:herdr` above stays the managed default, and no machine's
# home directory ends up in the source.
config-file = ?config.local
