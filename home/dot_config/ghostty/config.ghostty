# Appearance
theme = iTerm2 Tango Dark

font-family = MesloLGS NF
font-size = 14
font-feature = -calt, -liga, -dlig
font-thicken = false
bold-color = bright
faint-opacity = 1

background = #000000
foreground = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000

# Command-F search matches take tmux copy mode's colours: a plain hit dimmed,
# the focused hit in the selection colour.
search-background = #303030
search-foreground = #ffffff
search-selected-background = #b5d5ff
search-selected-foreground = #000000

cursor-color = #ffffff
cursor-text = #000000
cursor-style = bar
cursor-style-blink = true

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
background-opacity = 0.8
background-opacity-cells = false
background-blur = true
# Unfocused splits already dim themselves; the divider carries what
# pane-border-style gave tmux.
split-divider-color = #303030

macos-titlebar-style = tabs
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# Input
mouse-hide-while-typing = false
focus-follows-mouse = false
copy-on-select = clipboard
right-click-action = context-menu

# iTerm had unlimited scrollback; Ghostty uses a byte limit.
scrollback-limit = 268435456
scrollbar = system

# Visual bell without sound
bell-features = no-system,no-audio,attention,border

# Send the standard clear-screen key through tmux to the active application.
keybind = super+k=text:\x0c

# Remove the legacy Ctrl-V mapping so Claude Code receives native Shift-Enter.
keybind = shift+enter=unbind

# Shell
shell-integration = detect
shell-integration-features = cursor,title,ssh-env,path
command = direct:tmux new-session -A -s main

# Raycast Hyper (Ctrl+Option+Command) chords drive tmux. Each sends Meta-C-a
# and the key, which tmux treats as its Ctrl-a prefix, except in a pane
# running ssht, where it passes through so the chords drive the remote tmux.
# Hyper-Space sends the plain prefix, which always stays with the local tmux.
keybind = ctrl+alt+super+space=text:\x01
keybind = ctrl+alt+super+c=text:\x1b\x01c
keybind = ctrl+alt+super+i=text:\x1b\x01|
keybind = ctrl+alt+super+Slash=text:\x1b\x01-
keybind = ctrl+alt+super+z=text:\x1b\x01z
keybind = ctrl+alt+super+equal=text:\x1b\x01E
keybind = ctrl+alt+super+r=text:\x1b\x01r
keybind = ctrl+alt+super+x=text:\x1b\x01x
keybind = ctrl+alt+super+w=text:\x1b\x01x
keybind = ctrl+alt+super+arrow_left=text:\x1b\x01\x1b[D
keybind = ctrl+alt+super+arrow_down=text:\x1b\x01\x1b[B
keybind = ctrl+alt+super+arrow_up=text:\x1b\x01\x1b[A
keybind = ctrl+alt+super+arrow_right=text:\x1b\x01\x1b[C
keybind = ctrl+alt+super+shift+arrow_left=text:\x1b\x01\x1b[1;2D
keybind = ctrl+alt+super+shift+arrow_down=text:\x1b\x01\x1b[1;2B
keybind = ctrl+alt+super+shift+arrow_up=text:\x1b\x01\x1b[1;2A
keybind = ctrl+alt+super+shift+arrow_right=text:\x1b\x01\x1b[1;2C
keybind = ctrl+alt+super+Digit0=text:\x1b\x010
keybind = ctrl+alt+super+Digit1=text:\x1b\x011
keybind = ctrl+alt+super+Digit2=text:\x1b\x012
keybind = ctrl+alt+super+Digit3=text:\x1b\x013
keybind = ctrl+alt+super+Digit4=text:\x1b\x014
keybind = ctrl+alt+super+Digit5=text:\x1b\x015
keybind = ctrl+alt+super+Digit6=text:\x1b\x016
keybind = ctrl+alt+super+Digit7=text:\x1b\x017
keybind = ctrl+alt+super+Digit8=text:\x1b\x018
keybind = ctrl+alt+super+Digit9=text:\x1b\x019
keybind = ctrl+alt+super+comma=text:\x1b\x01,
keybind = ctrl+alt+super+shift+comma=text:\x1b\x01<
keybind = ctrl+alt+super+shift+period=text:\x1b\x01>
keybind = ctrl+alt+super+n=text:\x1b\x01n
keybind = ctrl+alt+super+p=text:\x1b\x01p
keybind = ctrl+alt+super+tab=text:\x1b\x01l
keybind = ctrl+alt+super+f=text:\x1b\x01w
keybind = ctrl+alt+super+b=text:\x1b\x01!
keybind = ctrl+alt+super+j=text:\x1b\x01j
keybind = ctrl+alt+super+m=text:\x1b\x01m
keybind = ctrl+alt+super+u=text:\x1b\x01u
keybind = ctrl+alt+super+h=text:\x1b\x01h

# Machine-local overrides, last so they win. Optional: a machine without one
# is not an error. This is where a Dock-launched Ghostty, which has launchd's
# PATH and cannot find Homebrew's tmux, names the absolute path — the
# portable `direct:tmux` above stays the managed default (test.sh enforces
# it), and no machine's Homebrew prefix ends up in the source.
config-file = ?config.local
