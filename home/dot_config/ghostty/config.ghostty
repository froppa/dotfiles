# ~/.config/ghostty/config

# =======================================
# Appearance
# =======================================

theme = iTerm2 Tango Dark

font-family = MesloLGS NF
font-size = 14
font-feature = -calt, -liga, -dlig
font-thicken = false
bold-color = bright
faint-opacity = 1

background = #000000
foreground = #ffffff

selection-background = #b5d5ff
selection-foreground = #000000

# Command-F search
search-background = #303030
search-foreground = #ffffff
search-selected-background = #b5d5ff
search-selected-foreground = #000000

cursor-color = #ffffff
cursor-text = #000000
cursor-style = bar
cursor-style-blink = true


# =======================================
# Window / tabs
# =======================================

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

background-opacity = 0.8
background-opacity-cells = false
background-blur = true

split-divider-color = #303030

# Native macOS tabs integrated into the titlebar,
# closest to the iTerm2 tab appearance.
macos-titlebar-style = native

confirm-close-surface = false
quit-after-last-window-closed = true

macos-option-as-alt = left


# =======================================
# Input
# =======================================

mouse-hide-while-typing = false
focus-follows-mouse = false

copy-on-select = clipboard
right-click-action = context-menu


# =======================================
# Scrollback
# =======================================

# 256 MiB
scrollback-limit = 268435456
scrollbar = system


# =======================================
# Bell / notifications
# =======================================

bell-features = no-system,no-audio,attention,no-border

# Optional:
# notify-on-command-finish = unfocused
# notify-on-command-finish-action = bell,notify


# =======================================
# Keyboard
# =======================================

# Cmd-K: clear screen
keybind = super+k=text:\x0c

# Let applications such as Claude Code handle Shift-Enter.
keybind = shift+enter=unbind


# =======================================
# Shell
# =======================================

# Ghostty launches a normal zsh.
# ~/.zshrc is responsible for loading Starship.
command = /bin/zsh

shell-integration = zsh
shell-integration-features = cursor,title,ssh-env,path


# =======================================
# Herdr
# =======================================

# Herdr is NOT Ghostty's shell.
# These Hyper chords are handled externally by Herdr.
# Unknown chords are swallowed instead of reaching zsh
# as escape/control sequences.

keybind = ctrl+alt+super+w=ignore
keybind = ctrl+alt+super+Digit0=ignore
keybind = ctrl+alt+super+tab=ignore
keybind = ctrl+alt+super+b=ignore
keybind = ctrl+alt+super+j=ignore
keybind = ctrl+alt+super+m=ignore
keybind = ctrl+alt+super+u=ignore


# =======================================
# Native panes and tabs (Hyper = Caps)
# =======================================

# Same chords as Herdr's [keys], so muscle memory carries over.
# Ghostty consumes these before the pty; inside Herdr use its
# prefix (Hyper-Space) for the ones it also binds.

keybind = ctrl+alt+super+i=new_split:right
keybind = ctrl+alt+super+slash=new_split:down
keybind = ctrl+alt+super+z=toggle_split_zoom
keybind = ctrl+alt+super+x=close_surface
keybind = ctrl+alt+super+equal=equalize_splits

keybind = ctrl+alt+super+arrow_left=goto_split:left
keybind = ctrl+alt+super+arrow_down=goto_split:down
keybind = ctrl+alt+super+arrow_up=goto_split:up
keybind = ctrl+alt+super+arrow_right=goto_split:right

keybind = ctrl+alt+super+shift+arrow_left=resize_split:left,10
keybind = ctrl+alt+super+shift+arrow_down=resize_split:down,10
keybind = ctrl+alt+super+shift+arrow_up=resize_split:up,10
keybind = ctrl+alt+super+shift+arrow_right=resize_split:right,10

keybind = ctrl+alt+super+c=new_tab
keybind = ctrl+alt+super+p=previous_tab
keybind = ctrl+alt+super+n=next_tab
keybind = ctrl+alt+super+comma=prompt_tab_title
keybind = ctrl+alt+super+shift+comma=move_tab:-1
keybind = ctrl+alt+super+shift+period=move_tab:1
keybind = ctrl+alt+super+digit_1=goto_tab:1
keybind = ctrl+alt+super+digit_2=goto_tab:2
keybind = ctrl+alt+super+digit_3=goto_tab:3
keybind = ctrl+alt+super+digit_4=goto_tab:4
keybind = ctrl+alt+super+digit_5=goto_tab:5
keybind = ctrl+alt+super+digit_6=goto_tab:6
keybind = ctrl+alt+super+digit_7=goto_tab:7
keybind = ctrl+alt+super+digit_8=goto_tab:8
keybind = ctrl+alt+super+digit_9=goto_tab:9


# =======================================
# Machine-local overrides
# =======================================

# Optional. Keep command=/bin/zsh unless you explicitly
# want a machine to launch something else.
# config-file = ?config.local