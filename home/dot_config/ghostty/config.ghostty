# Appearance
theme = iTerm2 Tango Dark

font-family = MesloLGS NF
font-size = 14
font-feature = -calt, -liga, -dlig
font-thicken = false
bold-color = bright
faint-opacity = 1

background = #000000
foreground = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000

cursor-color = #ffffff
cursor-text = #000000
cursor-style = bar
cursor-style-blink = true

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
background-opacity = 0.8
background-opacity-cells = false
background-blur = true

macos-titlebar-style = tabs
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# Input
mouse-hide-while-typing = false
focus-follows-mouse = false
copy-on-select = clipboard
right-click-action = context-menu

# iTerm had unlimited scrollback; Ghostty uses a byte limit.
scrollback-limit = 268435456
scrollbar = system

# Visual bell without sound
bell-features = no-system,no-audio,attention,border

# Send the standard clear-screen key through tmux to the active application.
keybind = super+k=text:\x0c

# Remove the legacy Ctrl-V mapping so Claude Code receives native Shift-Enter.
keybind = shift+enter=unbind

# Shell
shell-integration = detect
shell-integration-features = cursor,title,ssh-env,path
# Ghostty owns tabs, splits, scrollback and selection. tmux is only for
# sessions that must outlive the window: `tm` locally, `ssht <host>` remotely.
window-save-state = always

# Raycast Hyper (Ctrl+Option+Command) chords, the same keys the tmux config
# binds behind Ctrl-a, mapped to Ghostty actions.
keybind = ctrl+alt+super+c=new_tab
keybind = ctrl+alt+super+i=new_split:right
keybind = ctrl+alt+super+Slash=new_split:down
keybind = ctrl+alt+super+z=toggle_split_zoom
keybind = ctrl+alt+super+equal=equalize_splits
keybind = ctrl+alt+super+r=reload_config
keybind = ctrl+alt+super+x=close_surface
keybind = ctrl+alt+super+w=close_surface
keybind = ctrl+alt+super+arrow_left=goto_split:left
keybind = ctrl+alt+super+arrow_down=goto_split:down
keybind = ctrl+alt+super+arrow_up=goto_split:up
keybind = ctrl+alt+super+arrow_right=goto_split:right
keybind = ctrl+alt+super+shift+arrow_left=resize_split:left,10
keybind = ctrl+alt+super+shift+arrow_down=resize_split:down,10
keybind = ctrl+alt+super+shift+arrow_up=resize_split:up,10
keybind = ctrl+alt+super+shift+arrow_right=resize_split:right,10
keybind = ctrl+alt+super+n=next_tab
keybind = ctrl+alt+super+p=previous_tab
keybind = ctrl+alt+super+f=toggle_tab_overview
keybind = ctrl+alt+super+Digit0=last_tab
keybind = ctrl+alt+super+Digit1=goto_tab:1
keybind = ctrl+alt+super+Digit2=goto_tab:2
keybind = ctrl+alt+super+Digit3=goto_tab:3
keybind = ctrl+alt+super+Digit4=goto_tab:4
keybind = ctrl+alt+super+Digit5=goto_tab:5
keybind = ctrl+alt+super+Digit6=goto_tab:6
keybind = ctrl+alt+super+Digit7=goto_tab:7
keybind = ctrl+alt+super+Digit8=goto_tab:8
keybind = ctrl+alt+super+Digit9=goto_tab:9

# Machine-local overrides, last so they win. Optional: a machine without one
# is not an error.
config-file = ?config.local
