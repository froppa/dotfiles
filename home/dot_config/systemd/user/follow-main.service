[Unit]
Description=Follow main: dotfiles through chezmoi, then Verk through its installer
After=network-online.target

[Service]
Type=oneshot
# systemd --user starts with a compiled-in PATH; name where the tools are.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/follow-main.sh
