{{- /* Colima prepends this absolute line itself when missing; managing it keeps the file stable. */ -}}
{{ if eq .chezmoi.os "darwin" -}}
Include {{ .chezmoi.homeDir }}/.colima/ssh_config

{{ end -}}
# Managed by chezmoi. Machine-specific hosts belong in the unmanaged
# ~/.ssh/config.local; it is included first so its Host blocks win.
Include ~/.ssh/config.local

HashKnownHosts no

# Defaults for every host that config.local does not pin. No IdentitiesOnly
# here: local agent keys are offered alongside the default file.
Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
