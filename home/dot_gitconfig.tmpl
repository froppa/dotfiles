[user]
  name = {{ .name | quote }}
  email = {{ .email | quote }}
  useConfigOnly = true
{{- if .signingKey }}
  signingkey = {{ .signingKey | quote }}
{{- end }}

{{- if .signingKey }}
[commit]
  gpgsign = true
{{- end }}

[alias]
  # Helpers
  aliases = config --get-regexp "^alias\\."
  current = branch --show-current
  default = "!f() { ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && { printf '%s\n' \"${ref#origin/}\"; return; }; git show-ref --verify --quiet refs/remotes/origin/main && { echo main; return; }; git show-ref --verify --quiet refs/remotes/origin/master && { echo master; return; }; git config --get init.defaultBranch; }; f"
  root = rev-parse --show-toplevel
  whoami = config user.email

  # Status
  s = status -sb --show-stash --no-renames

  # Diff
  d = "!git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"
  dc = diff --cached
  dom = "!f() { git diff \"origin/$(git default)\"; }; f"
  wd = diff --patience --word-diff

  # Log
  l = log --oneline
  lg = log --graph --decorate --oneline --all
  ls = log --graph --abbrev-commit --pretty=oneline -20
  lstag = ls-remote --tags origin
  recent = "for-each-ref --count=25 --sort=-committerdate --format=%(refname:short) refs/heads/"
  sh = "!f() { commit=$(git log -16 --pretty=format:'%h %s' --no-merges | fzf | cut -d' ' -f1); test -n \"$commit\" && git show \"$commit\"; }; f"

  # Add
  a = add
  ap = add -p

  # Commit
  amend = commit --amend
  ca = commit --amend -C HEAD --no-edit
  caa = commit -a --amend -C HEAD
  cane = commit --amend --no-edit
  cf = commit --fixup
  cm = commit --message
  fu = "!f() { commit=$(git log -16 --pretty=format:'%h %s' --no-merges | fzf | cut -d' ' -f1); test -n \"$commit\" && git commit --fixup \"$commit\"; }; f"
  fup1 = commit --fixup HEAD~1
  fup2 = commit --fixup HEAD~2
  fup3 = commit --fixup HEAD~3
  signlast = "!~/.local/bin/git-signlast"
  ss = commit --message "chore: snapshot" --no-gpg-sign
  unamend = reset --mixed HEAD@{1}

  # Branch / Switch
  b = branch
  bm = branch --merged
  bnm = branch --no-merged
  sw = switch
  swc = switch -c

  # Fetch / Push
  fo = fetch origin
  fop = "! git fo && git pull origin"
  po = push
  pof = push --force-with-lease

  # Rebase
  ra = rebase --abort
  rc = rebase --continue
  reb = "!f() { test -n \"$1\" || { echo \"usage: git reb <count>\" >&2; return 2; }; git rebase -i \"HEAD~$1\"; }; f"
  ri = rebase -i
  riom = "!f() { git fetch origin && git rebase -i \"origin/$(git default)\"; }; f"

  # Cherry-pick
  cp = cherry-pick

  # GitHub
  npr = "!gh pr create --web"
  opr = "!gh pr view --web"

  # Index
  ignore = update-index --assume-unchanged
  ignored = "!git ls-files -v | grep '^[[:lower:]]'"
  unignore = update-index --no-assume-unchanged

[branch]
  sort = -committerdate

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  frag = magenta bold
  meta = yellow bold
  new = green
  old = red

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[core]
  editor = vim
  excludesfile = ~/.config/git/.gitignore.global

{{- $ghPath := lookPath "gh" }}
{{- if $ghPath }}
[credential "https://gist.github.com"]
  helper =
  helper = !{{ $ghPath }} auth git-credential

[credential "https://github.com"]
  helper =
  helper = !{{ $ghPath }} auth git-credential
{{- end }}

[diff]
  algorithm = histogram
  colorMoved = plain

[diff "bin"]
  textconv = hexdump -v -C

[fetch]
  all = true
  prune = true

[grep]
  lineNumber = true

[init]
  defaultBranch = main

[interactive]
  singleKey = true

[merge]
  conflictStyle = zdiff3

[pager]
  branch = false
  grep = false

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  default = current
  followTags = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  autoupdate = true
  enabled = true

[status]
  submoduleSummary = true

[tag]
  sort = version:refname

[url "git@github.com:"]
  insteadOf = gh:
  insteadOf = github:
  insteadOf = git://github.com/

[include]
  path = ~/.gitconfig.local
