# ~/.zshrc
# Managed by chezmoi

# ── Environment ──────────────────────────────────────────────

export GOBIN="$HOME/.local/bin"
export LESS="--tabs=2 --no-init --LONG-PROMPT --ignore-case --quit-if-one-screen --RAW-CONTROL-CHARS"

if (( $+commands[zed] )); then
  export EDITOR="zed --wait"
elif (( $+commands[nvim] )); then
  export EDITOR=nvim
else
  export EDITOR=vim
fi

export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"

[[ -n ${TTY:-} ]] && export GPG_TTY="$TTY"

# ── PATH ─────────────────────────────────────────────────────

typeset -U path PATH

path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.cargo/bin"
  $path
)

# ── History ──────────────────────────────────────────────────

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS

# ── Shell ────────────────────────────────────────────────────

setopt AUTO_CD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS
setopt TRANSIENT_RPROMPT

# ── Completion ───────────────────────────────────────────────

autoload -Uz compinit
compinit

[[ -r "$HOME/.zsh_completions" ]] &&
  source "$HOME/.zsh_completions"

# ── Shared config ─────────────────────────────────────────────

[[ -r "$HOME/.exports" ]] &&
  source "$HOME/.exports"

[[ -r "$HOME/.aliases" ]] &&
  source "$HOME/.aliases"

[[ -r "$HOME/.functions" ]] &&
  source "$HOME/.functions"

# ── Linux executable compatibility ───────────────────────────

(( ! $+commands[fd]  && $+commands[fdfind] )) && alias fd=fdfind
(( ! $+commands[bat] && $+commands[batcat] )) && alias bat=batcat

# ── Keys ─────────────────────────────────────────────────────

bindkey -e

bindkey '^B' backward-word
bindkey '^R' history-incremental-pattern-search-backward
bindkey '^F' history-incremental-pattern-search-forward

bindkey '^[^?'    backward-kill-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5H' beginning-of-line
bindkey '^[[1;5F' end-of-line

# Fn-arrows: Home/End arrive as CSI or SS3 depending on keypad mode.
bindkey '^[[H'  beginning-of-line
bindkey '^[OH'  beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[OF'  end-of-line
bindkey '^[[5~' up-line-or-history
bindkey '^[[6~' down-line-or-history

# ── fzf ──────────────────────────────────────────────────────

if (( $+commands[fzf] )); then
  source <(fzf --zsh)

  _fd="${commands[fd]:-${commands[fdfind]:-}}"

  if [[ -n "$_fd" ]]; then
    export FZF_DEFAULT_COMMAND="${(q)_fd} --type f --hidden --follow --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="${(q)_fd} --type d --hidden --follow --exclude .git"
  fi

  unset _fd
fi

# ── Runtime tools ─────────────────────────────────────────────

(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[mise] ))   && eval "$(mise activate zsh)"
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# ── Plugins ──────────────────────────────────────────────────

_source_plugin() {
  local plugin="$1" file

  for file in \
    "${HOMEBREW_PREFIX:-}/share/$plugin/$plugin.plugin.zsh" \
    "${HOMEBREW_PREFIX:-}/share/$plugin/$plugin.zsh" \
    "/usr/share/$plugin/$plugin.plugin.zsh" \
    "/usr/share/$plugin/$plugin.zsh" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins/$plugin/$plugin.plugin.zsh"
  do
    [[ -n "$file" && -r "$file" ]] || continue
    source "$file"
    return
  done
}

_source_plugin fzf-tab
_source_plugin zsh-autosuggestions

# ── Herdr ────────────────────────────────────────────────────

# Ghostty binds the same Hyper chords as Herdr. While Herdr runs, switch
# this surface to Ghostty's `herdr` key table so the chords reach Herdr.
# Skipped inside Herdr panes: a nested client must not reset the table.
if [[ $OSTYPE == darwin* && $TERM_PROGRAM == ghostty ]] &&
  (( $+commands[herdr] && $+commands[osascript] )); then
  herdr() {
    [[ -n $HERDR_ENV ]] && { command herdr "$@"; return }
    local id rc
    id=$(osascript -e 'tell application "Ghostty"
      set t to focused terminal of selected tab of front window
      perform action "activate_key_table:herdr" on t
      return id of t
    end tell' 2>/dev/null)
    command herdr "$@"
    rc=$?
    [[ -n $id ]] && osascript -e 'on run argv
      tell application "Ghostty" to perform action "deactivate_all_key_tables" on terminal id (item 1 of argv)
    end run' "$id" >/dev/null 2>&1
    return rc
  }
fi

# ── Prompt ───────────────────────────────────────────────────

(( $+commands[starship] )) &&
  eval "$(starship init zsh)"

# ── Terminal recovery ────────────────────────────────────────

[[ -r "$HOME/.config/zsh/terminal.zsh" ]] &&
  source "$HOME/.config/zsh/terminal.zsh"

# ── Prompt status caches ──────────────────────────────────────

[[ -r "$HOME/.config/zsh/status.zsh" ]] &&
  source "$HOME/.config/zsh/status.zsh"

# ── Machine-local ─────────────────────────────────────────────

[[ -r "$HOME/.zshrc.local" ]] &&
  source "$HOME/.zshrc.local"

# Must remain last.
_source_plugin zsh-syntax-highlighting

unfunction _source_plugin
