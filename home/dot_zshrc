# ~/.zshrc
# Managed by chezmoi

# =======================================
# Environment
# =======================================
export LC_ALL="en_US.UTF-8"
export EDITOR="vim"
export VISUAL="vim"
export LESS="--tabs=2 --no-init --LONG-PROMPT --ignore-case --quit-if-one-screen --RAW-CONTROL-CHARS"

# Go
export GOPATH="$HOME"
export GOBIN="$HOME/.local/bin"
export GO111MODULE="on"

# =======================================
# PATH
# zsh-native, deduplicated, portable
# =======================================
typeset -U path PATH

path_prepend_if_exists() {
  local dir="$1"
  [[ -d "$dir" ]] && path=("$dir" $path)
}

path_prepend_if_exists "$HOME/.local/bin"
path_prepend_if_exists "$HOME/bin"
path_prepend_if_exists "$HOME/go/bin"
path_prepend_if_exists "$HOME/.cargo/bin"

export PATH

# =======================================
# History
# =======================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
HIST_STAMPS="yyyy-mm-dd"

setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE

# =======================================
# Shell options
# =======================================
setopt AUTO_CD
setopt RM_STAR_SILENT
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS

# =======================================
# Prompt / theme
# =======================================
CASE_SENSITIVE="true"
ZSH_DISABLE_COMPFIX="true"
ZSH_THEME="simple"

# =======================================
# Oh My Zsh
# =======================================
export ZSH="$HOME/.oh-my-zsh"

plugins=(
  chezmoi
  git
  z
  fzf-tab
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit -d "$HOME/.zcompdump"
fi

# =======================================
# Aliases
# =======================================
alias g="git"

# Ubuntu exposes these programs under different executable names.
(( ! $+commands[fd] && $+commands[fdfind] )) && alias fd="fdfind"
(( ! $+commands[bat] && $+commands[batcat] )) && alias bat="batcat"

gpgkeys() {
  gpg -K --with-colons 2>/dev/null | awk -F: '$1 == "sec" { print $5 }'
}

# =======================================
# GPG agent
# =======================================
if command -v gpgconf >/dev/null 2>&1; then
  gpgconf --launch gpg-agent >/dev/null 2>&1 || true
fi

# =======================================
# Key bindings
# =======================================
bindkey "^a" beginning-of-line
bindkey "^e" end-of-line
bindkey "^f" forward-word
bindkey "^b" backward-word
bindkey "^k" kill-line
bindkey "^d" delete-char
bindkey "^w" backward-kill-word
bindkey "^u" backward-kill-line
bindkey "^R" history-incremental-pattern-search-backward
bindkey "^F" history-incremental-pattern-search-forward

# Alt-backspace / arrow compatibility
bindkey '^[^?' backward-kill-word
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
# Ctrl+Fn+Left/Right may arrive as either Ctrl+Home/End encoding.
bindkey "^[[1;5H" beginning-of-line
bindkey "^[[1;5F" end-of-line
bindkey "^[[5H" beginning-of-line
bindkey "^[[5F" end-of-line
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# =======================================
# fzf — fuzzy history (^R), files (^T), cd (Alt-C)
# Sourced after key bindings so fzf's ^R wins
# =======================================
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  # fzf launches a child shell, so a Zsh alias alone cannot provide fd.
  fd_command="${commands[fd]:-${commands[fdfind]:-}}"
  if [[ -n "$fd_command" ]]; then
    export FZF_DEFAULT_COMMAND="${(q)fd_command} --type f --hidden --follow --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="${(q)fd_command} --type d --hidden --follow --exclude .git"
  fi
  unset fd_command
fi

# =======================================
# Local overrides
# =======================================
[[ -f "$HOME/.zsh_completions" ]] && source "$HOME/.zsh_completions"
[[ -f "$HOME/.zsh_completions.local" ]] && source "$HOME/.zsh_completions.local"
[[ -f "$HOME/.exports" ]] && source "$HOME/.exports"
[[ -f "$HOME/.exports.local" ]] && source "$HOME/.exports.local"
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.functions" ]] && source "$HOME/.functions"
[[ -f "$HOME/.functions.local" ]] && source "$HOME/.functions.local"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# =======================================
# Runtimes (mise) + per-directory envs (direnv)
# =======================================
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# =======================================
# Prompt
# Prefer starship if installed
# =======================================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Agent counts and Claude/Codex limits for starship's right prompt: the tmux
# status scripts refresh plain-text caches in the background, at most every
# 10 s, so the prompt itself never waits on ssh or the usage endpoints.
if [[ -x "$HOME/.config/tmux/scripts/status-agents.sh" ]]; then
  zmodload -F zsh/stat b:zstat 2>/dev/null
  _status_cache_refresh() {
    local d="${XDG_CACHE_HOME:-$HOME/.cache}/tmux" s="$HOME/.config/tmux/scripts"
    mkdir -p "$d"
    "$s/status-agents.sh" | sed 's/#\[[^]]*\]//g' > "$d/agents.txt.$$" && mv -f "$d/agents.txt.$$" "$d/agents.txt"
    "$s/status-usage.sh" | sed 's/#\[[^]]*\]//g' > "$d/limits.txt.$$" && mv -f "$d/limits.txt.$$" "$d/limits.txt"
  }
  _status_cache_precmd() {
    local -a m
    zstat -A m +mtime "${XDG_CACHE_HOME:-$HOME/.cache}/tmux/agents.txt" 2>/dev/null
    (( EPOCHSECONDS - ${m[1]:-0} < 10 )) && return
    ( _status_cache_refresh >/dev/null 2>&1 & )
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _status_cache_precmd
fi

# Transient right prompt: once a command line is accepted the right side is
# cleared, so only the live prompt carries status and the scrollback stays
# clean. Starship's precmd hook sets it again for the next prompt.
_rprompt_transient() { RPROMPT=''; zle reset-prompt; }
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-finish _rprompt_transient
