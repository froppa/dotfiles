# ~/.zshrc
# Managed by chezmoi

# =======================================
# Environment
# =======================================
export LC_ALL="en_US.UTF-8"
export EDITOR="vim"
export VISUAL="vim"
export LESS="--tabs=2 --no-init --LONG-PROMPT --ignore-case --quit-if-one-screen --RAW-CONTROL-CHARS"

# Go
export GOPATH="$HOME"
export GOBIN="$HOME/.local/bin"
export GO111MODULE="on"

# SSH
export SSH_KEY_PATH="$HOME/.ssh"

# =======================================
# PATH
# zsh-native, deduplicated, portable
# =======================================
typeset -U path PATH

path_prepend_if_exists() {
  local dir="$1"
  [[ -d "$dir" ]] && path=("$dir" $path)
}

path_prepend_if_exists "$HOME/.local/bin"
path_prepend_if_exists "$HOME/bin"
path_prepend_if_exists "$HOME/go/bin"
path_prepend_if_exists "$HOME/.cargo/bin"

export PATH

# =======================================
# History
# =======================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
HIST_STAMPS="yyyy-mm-dd"

setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE

# =======================================
# Shell options
# =======================================
setopt AUTO_CD
setopt RM_STAR_SILENT
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS

# =======================================
# Prompt / theme
# =======================================
CASE_SENSITIVE="true"
ZSH_DISABLE_COMPFIX="true"
ZSH_THEME="simple"

# =======================================
# Oh My Zsh
# =======================================
export ZSH="$HOME/.oh-my-zsh"

plugins=(
  chezmoi
  git
  z
  fzf-tab
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -d "$ZSH" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit -d "$HOME/.zcompdump"
fi

# =======================================
# Aliases
# =======================================
alias g="git"

command -v fdfind >/dev/null 2>&1 && alias fd="fdfind"

gpgkeys() {
  gpg -K --with-colons 2>/dev/null | awk -F: '$1 == "sec" { print $5 }'
}

# =======================================
# Agent helpers
# =======================================
if command -v gpgconf >/dev/null 2>&1; then
  gpgconf --launch gpg-agent >/dev/null 2>&1 || true
fi

if [[ "$OSTYPE" == darwin* ]]; then
  # Load the keychain-backed key only when the agent is reachable but empty.
  if [[ -x /usr/bin/ssh-add ]] &&
     [[ -f "$HOME/.ssh/id_ed25519" ]] &&
     [[ -S "${SSH_AUTH_SOCK:-/dev/null}" ]] &&
     ! /usr/bin/ssh-add -l >/dev/null 2>&1; then
    /usr/bin/ssh-add --apple-use-keychain >/dev/null 2>&1 || true
  fi
else
  # Reuse a persistent agent across logins instead of spawning one per shell.
  if [[ -z "${SSH_AUTH_SOCK:-}" ]] && command -v ssh-agent >/dev/null 2>&1; then
    agent_env="$HOME/.ssh/agent-env"
    if [[ -f "$agent_env" ]]; then
      source "$agent_env" >/dev/null 2>&1
      # Drop the recorded agent when it is unreachable (exit 2); an empty
      # but live agent (exit 1) is fine to reuse.
      ssh-add -l >/dev/null 2>&1
      if [[ $? -eq 2 ]]; then
        unset SSH_AUTH_SOCK SSH_AGENT_PID
      fi
    fi
    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
      mkdir -p "$HOME/.ssh"
      ssh-agent -s >"$agent_env"
      chmod 600 "$agent_env"
      source "$agent_env" >/dev/null 2>&1
    fi
    unset agent_env
  fi
fi

# =======================================
# Key bindings
# =======================================
bindkey "^a" beginning-of-line
bindkey "^e" end-of-line
bindkey "^f" forward-word
bindkey "^b" backward-word
bindkey "^k" kill-line
bindkey "^d" delete-char
bindkey "^w" backward-kill-word
bindkey "^u" backward-kill-line
bindkey "^R" history-incremental-pattern-search-backward
bindkey "^F" history-incremental-pattern-search-forward

# Alt-backspace / arrow compatibility
bindkey '^[^?' backward-kill-word
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# =======================================
# fzf — fuzzy history (^R), files (^T), cd (Alt-C)
# Sourced after key bindings so fzf's ^R wins
# =======================================
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
fi

# =======================================
# Local overrides
# =======================================
[[ -f "$HOME/.zsh_completions" ]] && source "$HOME/.zsh_completions"
[[ -f "$HOME/.zsh_completions.local" ]] && source "$HOME/.zsh_completions.local"
[[ -f "$HOME/.exports" ]] && source "$HOME/.exports"
[[ -f "$HOME/.exports.local" ]] && source "$HOME/.exports.local"
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.functions" ]] && source "$HOME/.functions"
[[ -f "$HOME/.functions.local" ]] && source "$HOME/.functions.local"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# =======================================
# Runtimes (mise) + per-directory envs (direnv)
# =======================================
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# =======================================
# Prompt
# Prefer starship if installed
# =======================================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
