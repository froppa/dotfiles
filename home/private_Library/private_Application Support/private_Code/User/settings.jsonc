{
  // ===== Language-specific: Go =====
  "[go]": {
    "editor.tabSize": 4,
    "editor.indentSize": "tabSize",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
    },
  },
  "go.editorContextMenuCommands": {
    "addImport": true,
    "addTags": true,
    "benchmarkAtCursor": false,
    "debugTestAtCursor": false,
    "fillStruct": true,
    "generateTestForFile": true,
    "generateTestForFunction": true,
    "generateTestForPackage": true,
    "playground": false,
    "removeTags": false,
    "testAtCursor": true,
    "testCoverage": true,
    "testFile": false,
    "testPackage": true,
    "toggleTestFile": true,
  },
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--fast"
  ],
  "go.formatTool": "gofumpt",
  "go.toolsManagement.autoUpdate": true,
  "go.coverOnSingleTest": true,
  "go.coverOnSingleTestFile": true,
  // gopls (Go language server)
  "gopls": {
    "staticcheck": false,
    "usePlaceholders": false,
    "completeUnimported": true,
    "analyses": {
      "unusedparams": true,
    },
    "local": "github.com/clearhaus/gopkgs",
    "directoryFilters": [
      "-**/node_modules",
      "-**/.git",
      "-**/vendor",
      "-**/bin",
    ],
  },
  // ===== Language-specific: JSON / JSONC =====
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // ===== Language-specific: YAML / GitHub Actions =====
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.autoIndent": "keep",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true,
    },
    "editor.tabSize": 2,
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
  },
  // ===== Python =====
  "python.analysis.typeCheckingMode": "strict",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  // ===== Docker Compose =====
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[opentofu]": {},
  // ===== Editor =====
  // "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.indentSize": "tabSize",
  "editor.detectIndentation": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.suggest.showWords": false,
  "editor.wordBasedSuggestions": "off",
  "editor.stickyScroll.enabled": true,
  // ===== Files & Search =====
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.hg/**": true,
    "**/.svn/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/bin/**": true,
    "**/.gradle/**": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/bin": true,
    "**/.git": true,
  },
  "search.showLineNumbers": true,
  // ===== Explorer =====
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.openEditors.minVisible": 2,
  "explorer.openEditors.visible": 4,
  "explorer.openEditors.sortOrder": "alphabetical",
  // ===== Workbench/UI =====
  "workbench.preferredDarkColorTheme": "One Dark Pro Night Flat",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.list.openMode": "singleClick",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
  },
  "workbench.view.showQuietly": {
    "workbench.panel.output": true,
  },
  "workbench.editor.alwaysShowEditorActions": true,
  "workbench.tree.indent": 4,
  "window.titleBarStyle": "native",
  "window.commandCenter": false,
  "terminal.integrated.tabs.location": "left",
  // ===== Git =====
  "git.openRepositoryInParentFolders": "always",
  // ===== Security & Telemetry =====
  "security.workspace.trust.banner": "never",
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  // ===== Extensions =====
  "makefile.configureOnOpen": false,
  "docker.extension.enableComposeLanguageServer": false,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "terraform.languageServer.enable": false,
  "colorize.languages": [
    "astro",
    "ts",
    "js",
    "javascript",
    "html",
    "css",
    "sass",
    "scss",
    "less",
    "postcss",
    "sss",
    "stylus",
    "xml",
    "svg",
  ],
  // ===== Formatting / JS/TS =====
  "typescript.format.semicolons": "remove",
  "javascript.format.semicolons": "remove",
  "prettier.semi": false,
  "tsimporter.emitSemicolon": false,
  // ===== YAML =====
  "yaml.format.singleQuote": true,
  // ===== Copilot/Chat =====
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  // ===== Misc =====
  "breadcrumbs.enabled": true,
  "workbench.commandPalette.preserveInput": true,
  // ===== Spelling (cSpell) =====
  "cSpell.userWords": [
    "appfx",
    "bisnode",
    "bisnodeprocessor",
    "clearhaus",
    "CLRHS",
    "configfx",
    "Dykkerværkstedet",
    "eventspooler",
    "fxconfig",
    "httpfx",
    "keypair",
    "loggerfx",
    "mappi",
    "nolint",
    "opengraph",
    "pkgs",
    "rightalt",
    "riskclass",
    "Servicepriser",
  ],
  "githubPullRequests.pullBranch": "never",
  "git.autofetch": true,
  "yaml.schemas": {
    "file:///Users/sdf/.vscode/extensions/continue.continue-1.2.11-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml",
    ],
    "file:///Users/sdf/.vscode/extensions/continue.continue-1.2.14-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml",
    ],
  },
  "workbench.iconTheme": "material-icon-theme",
  "chat.mcp.gallery.enabled": true,
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "update.showReleaseNotes": false,
  "http.systemCertificatesNode": true,
  "geminicodeassist.project": "invertible-rampart-gdgph",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "workbench.view.alwaysShowHeaderActions": true,
  "workbench.editor.autoLockGroups": {
    "default": true,
    "mainThreadWebview-browserPreview": false,
    "mainThreadWebview-simpleBrowser.view": false,
  },
  "window.confirmSaveUntitledWorkspace": false,
  "window.nativeTabs": true,
  "telemetry.editStats.enabled": false,
  "diffEditor.codeLens": true,
  "geminicodeassist.displayInlineContextHint": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "workbench.editor.enablePreview": false,
  "workbench.activityBar.location": "top",
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
}
