# ~/.aliases
# Managed by chezmoi

# ── Base ─────────────────────────────────────────────────────

alias cls='clear'
alias d='dirs -v'
alias g='git'
alias dc='docker compose'
alias py='python3'

alias gitalias='git config --global --get-regexp "^alias\."'

if (( $+commands[grep] )); then
  alias grep='grep --color=auto'
  alias egrep='grep -E --color=auto'
fi

if (( $+commands[highlight] )); then
  alias ccat='highlight -O ansi'
fi

# ── Editor ───────────────────────────────────────────────────

if (( $+commands[nvim] )); then
  alias vi='nvim'
  alias vim='nvim'
  alias nano='nvim'
else
  alias vi='vim'
  alias nano='vim'
fi

# ── ls ───────────────────────────────────────────────────────

if (( $+commands[eza] )); then
  alias ls='eza'
  alias la='eza -a'
  alias ll='eza -lahH'
elif [[ "$OSTYPE" == darwin* ]]; then
  export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'

  alias ls='ls -G'
  alias la='ls -aG'
  alias ll='ls -lahG'
else
  alias ls='ls --color=auto'
  alias la='ls -a --color=auto'
  alias ll='ls -lah --color=auto'
fi

# Verbose, but don't change rm semantics.
alias rm='rm -v'

# ── Cross-platform open ──────────────────────────────────────

if [[ "$OSTYPE" != darwin* ]]; then
  if [[ -r /proc/version ]] &&
     grep -qi microsoft /proc/version 2>/dev/null; then
    alias open='explorer.exe'
  elif (( $+commands[xdg-open] )); then
    alias open='xdg-open'
  fi
fi

# ── Dotfiles / chezmoi ───────────────────────────────────────

alias reloadzsh='exec zsh'

alias ch='chezmoi'
alias dotapply='chezmoi apply -v'
alias dotdiff='chezmoi diff'
alias dotstatus='chezmoi status'

alias confzshenv='chezmoi edit --apply ~/.zshenv'
alias confzprofile='chezmoi edit --apply ~/.zprofile'
alias confzsh='chezmoi edit --apply ~/.zshrc'

alias confalias='chezmoi edit --apply ~/.aliases'
alias confexports='chezmoi edit --apply ~/.exports'
alias conffunctions='chezmoi edit --apply ~/.functions'
alias confzcompl='chezmoi edit --apply ~/.zsh_completions'

alias confstarship='chezmoi edit --apply ~/.config/starship.toml'
alias confterminal='chezmoi edit --apply ~/.config/zsh/terminal.zsh'

alias confgit='chezmoi edit --apply ~/.config/git/dotfiles.gitconfig'

# ── Navigation ────────────────────────────────────────────────

alias gocode='cd ~/code'

for i in {1..9}; do
  alias "$i"="pushd -$i >/dev/null && dirs -v"
done

unset i

# ── Updates ──────────────────────────────────────────────────

if [[ "$OSTYPE" == darwin* ]]; then
  if (( $+commands[brew] )); then
    alias brewup='brew update && brew upgrade && brew cleanup'
  fi

  alias update='sudo softwareupdate -i -a && brew update && brew upgrade && brew cleanup && npm install -g npm && npm update -g'

  alias afk='/System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend'
elif [[ "$OSTYPE" == linux* ]] && (( $+commands[apt-get] )); then
  alias update='sudo apt-get update && sudo apt-get upgrade'
fi

# ── Cleanup ──────────────────────────────────────────────────

alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"
