# ── Editor / dotfiles ────────────────────────────────────────

# EDITOR may contain arguments, e.g. "zed --wait".
editfile() {
  local -a editor
  editor=(${=EDITOR})
  "${editor[@]}" "$@"
}

dotcode() {
  editfile "$(chezmoi source-path)"
}

confzshl() {
  editfile "$HOME/.zshrc.local"
}

confgitl() {
  editfile "$HOME/.gitconfig.local"
}

# ── Navigation ────────────────────────────────────────────────

mkd() {
  if (( $# != 1 )); then
    print -u2 'usage: mkd <directory>'
    return 2
  fi

  mkdir -p "$1" && cd "$1"
}

pu() {
  pushd "$1" >/dev/null || return
  dirs -v
}

po() {
  popd >/dev/null || return
  dirs -v
}

# Enter the worktree that owns a branch.
gw() {
  local branch="${1:-}"

  if [[ -z "$branch" ]]; then
    git worktree list
    return
  fi

  local path
  path=$(
    git worktree list --porcelain |
      awk -v target="refs/heads/$branch" '
        $1 == "worktree" {
          path = $2
        }

        $1 == "branch" && $2 == target {
          print path
          exit
        }
      '
  )

  if [[ -z "$path" ]]; then
    print -u2 "No worktree found for branch: $branch"
    return 1
  fi

  cd "$path"
}

# ── Files ─────────────────────────────────────────────────────

# Create a symlink, replacing existing files/symlinks.
# Never remove a real directory.
symlink() {
  local target="$1"
  local link_name="$2"
  local overwritten=""

  if [[ -z "$target" || -z "$link_name" ]]; then
    print -u2 'usage: symlink <target> <link>'
    return 2
  fi

  if [[ -d "$link_name" && ! -L "$link_name" ]]; then
    print -u2 "symlink: $link_name is a real directory; refusing to remove"
    return 1
  fi

  if [[ -e "$link_name" || -L "$link_name" ]]; then
    overwritten=" (overwritten)"
    rm -f "$link_name" || return
  fi

  ln -s "$target" "$link_name" || return

  print -- "$link_name -> $target$overwritten"
}

extract() {
  if (( $# != 1 )); then
    print -u2 'usage: extract <archive>'
    return 2
  fi

  local archive="$1"

  case "$archive" in
    *.tar.gz|*.tgz)
      tar -xzf "$archive"
      ;;
    *.tar.bz2|*.tbz2)
      tar -xjf "$archive"
      ;;
    *.tar.xz|*.txz)
      tar -xJf "$archive"
      ;;
    *.tar)
      tar -xf "$archive"
      ;;
    *.zip)
      unzip "$archive"
      ;;
    *.gz)
      gunzip "$archive"
      ;;
    *.bz2)
      bunzip2 "$archive"
      ;;
    *)
      print -u2 "extract: unsupported archive: $archive"
      return 1
      ;;
  esac
}

# Create a .tar archive, then use the best available gzip compressor.
targz() {
  if (( $# == 0 )); then
    print -u2 'usage: targz <file-or-directory> [...]'
    return 2
  fi

  local tmp_file="${1%/}.tar"

  tar -cvf "$tmp_file" --exclude=".DS_Store" "$@" || return

  local size

  if size=$(stat -f '%z' "$tmp_file" 2>/dev/null); then
    :
  else
    size=$(stat -c '%s' "$tmp_file" 2>/dev/null) || return
  fi

  local compressor

  if (( size < 52428800 )) && (( $+commands[zopfli] )); then
    compressor=zopfli
  elif (( $+commands[pigz] )); then
    compressor=pigz
  else
    compressor=gzip
  fi

  print -- "Compressing $tmp_file ($(( size / 1000 )) kB) using $compressor…"

  "$compressor" -v "$tmp_file" || return

  local compressed_size

  if compressed_size=$(stat -f '%z' "$tmp_file.gz" 2>/dev/null); then
    :
  else
    compressed_size=$(stat -c '%s' "$tmp_file.gz" 2>/dev/null) || return
  fi

  print -- "$tmp_file.gz ($(( compressed_size / 1000 )) kB) created."
}

# Human-readable file/directory sizes.
fs() {
  setopt localoptions null_glob

  local arg='-sh'

  if du -b /dev/null >/dev/null 2>&1; then
    arg='-sbh'
  fi

  if (( $# > 0 )); then
    du $arg -- "$@"
  else
    du $arg .[^.]* ./*
  fi
}

# Interactive diff gets git's readable word-level colouring.
# Pipes/scripts retain real diff(1) semantics and output.
if (( $+commands[git] )); then
  diff() {
    if [[ -t 1 ]]; then
      git diff --no-index --color-words "$@"
    else
      command diff "$@"
    fi
  }
fi

dataurl() {
  if (( $# != 1 )); then
    print -u2 'usage: dataurl <file>'
    return 2
  fi

  local file="$1"
  local mime_type

  mime_type=$(file -b --mime-type "$file") || return

  if [[ "$mime_type" == text/* ]]; then
    mime_type="${mime_type};charset=utf-8"
  fi

  printf 'data:%s;base64,' "$mime_type"
  openssl base64 -in "$file" | tr -d '\n'
  printf '\n'
}

gz() {
  if (( $# != 1 )); then
    print -u2 'usage: gz <file>'
    return 2
  fi

  local origsize gzipsize ratio

  origsize=$(wc -c < "$1") || return
  gzipsize=$(gzip -c "$1" | wc -c) || return

  if (( origsize == 0 )); then
    print 'orig: 0 bytes'
    print "gzip: $gzipsize bytes"
    return
  fi

  ratio=$(
    awk "BEGIN {
      printf \"%.2f\", ($gzipsize / $origsize) * 100
    }"
  )

  printf 'orig: %d bytes\n' "$origsize"
  printf 'gzip: %d bytes (%s%%)\n' "$gzipsize" "$ratio"
}

# ── Network / TLS ─────────────────────────────────────────────

publicip() {
  if (( $+commands[dig] )); then
    dig +short myip.opendns.com @resolver1.opendns.com
  elif (( $+commands[curl] )); then
    curl -fsSL https://api.ipify.org
    printf '\n'
  else
    print -u2 'No dig or curl available'
    return 1
  fi
}

ips() {
  if (( $+commands[ip] )); then
    ip -o addr show | awk '{print $4}'
  else
    ifconfig -a |
      awk '
        /inet /  { print $2 }
        /inet6 / { print $2 }
      '
  fi
}

digga() {
  dig +nocmd "$1" any +multiline +noall +answer
}

getcertnames() {
  local domain="$1"

  if [[ -z "$domain" ]]; then
    print -u2 'usage: getcertnames <domain>'
    return 2
  fi

  print -- "Testing $domain…"

  local certificate

  certificate=$(
    openssl s_client \
      -connect "${domain}:443" \
      -servername "$domain" \
      </dev/null 2>/dev/null
  ) || return

  if [[ "$certificate" != *"-----BEGIN CERTIFICATE-----"* ]]; then
    print -u2 'Certificate not found.'
    return 1
  fi

  print
  print 'Subject:'

  print -r -- "$certificate" |
    openssl x509 -noout -subject

  print
  print 'Subject Alternative Names:'

  print -r -- "$certificate" |
    openssl x509 -noout -ext subjectAltName
}

# ── Open ──────────────────────────────────────────────────────

o() {
  local target="${1:-.}"

  if [[ "$OSTYPE" == darwin* ]]; then
    command open "$target"
  elif (( $+commands[xdg-open] )); then
    xdg-open "$target"
  elif (( $+commands[explorer.exe] )); then
    explorer.exe "$target"
  else
    print -u2 'No system open command found.'
    return 1
  fi
}

# ── Tree ──────────────────────────────────────────────────────

tre() {
  tree \
    -aC \
    -I '.git|node_modules|bower_components' \
    --dirsfirst \
    "$@" |
    less -FRNX
}

# ── Python ────────────────────────────────────────────────────

pytmpenv() {
  local tmpvenv

  tmpvenv=$(mktemp -d -t tmpvenv.XXXXXX) || return

  export PYTHON_TMP_ENV="$tmpvenv"

  python3 -m venv "$tmpvenv" || return
  source "$tmpvenv/bin/activate"
}

pytmpenv_delete() {
  if [[ -z "${PYTHON_TMP_ENV:-}" ]]; then
    print -u2 'No temporary Python environment is active.'
    return 1
  fi

  (( $+functions[deactivate] )) && deactivate

  rm -rf "$PYTHON_TMP_ENV"
  unset PYTHON_TMP_ENV
}

# ── GPG ───────────────────────────────────────────────────────

gpgkeys() {
  gpg -K --with-colons 2>/dev/null |
    awk -F: '$1 == "sec" { print $5 }'
}

# ── macOS ─────────────────────────────────────────────────────

if [[ "$OSTYPE" == darwin* ]]; then
  # Change to the top-most Finder window.
  cdf() {
    local path

    path=$(
      osascript \
        -e 'tell application "Finder" to POSIX path of (insertion location as alias)'
    ) || return

    cd "$path"
  }

  localip() {
    ipconfig getifaddr en0 2>/dev/null ||
      ipconfig getifaddr en1 2>/dev/null
  }

  ifactive() {
    ifconfig |
      awk '
        /^[a-z0-9]/ {
          iface=$1
          sub(":", "", iface)
        }

        /status: active/ {
          print iface
        }
      '
  }

  flush() {
    dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
  }

  lscleanup() {
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
      -r \
      -domain local \
      -domain system \
      -domain user &&
      killall Finder
  }
fi
