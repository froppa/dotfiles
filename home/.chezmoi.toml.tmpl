encryption = "age"

[age]
identity = "~/.config/sops/age/keys.txt"
recipient = "age1x8xj89ps3n8j2cy6guv2n9l788q0ud39yq0pw72lxehgdl2fdv8qqa0lfw"

{{ $computerName := "" }}
{{ if eq .chezmoi.os "darwin" }}
{{ $computerName = (output "scutil" "--get" "ComputerName" | trim) }}
{{ else }}
{{ $computerName = (output "hostname" | trim) }}
{{ end }}

{{ $name := promptStringOnce . "name" "name" }}
{{ $email := promptStringOnce . "email" "email" }}
{{ $signingKey := promptStringOnce . "signingKey" "signingKey" }}
{{/* WORK=true selects the work machine setup; anything else (incl. PERSONAL=true) is personal. */}}
{{ $work := eq (env "WORK" | lower) "true" }}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
signingKey = {{ $signingKey | quote }}
profile = {{ ternary "work" "personal" $work | quote }}
work = {{ $work }}
personal = {{ not $work }}
computerName = {{ $computerName | quote }}
hostname = {{ $computerName | quote }}

[github]
refreshPeriod = "12h"

[template]
options = ["missingkey=error"]
